# ==============================================================================
# BingeByte - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Never commit .env.local or real credentials to source control.

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# TMDB (The Movie Database) API Configuration
# Used for metadata, posters, backdrops, cast, and titles.
# (Configured in Phase 3)
TMDB_API_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# NexStream / Playback Provider Configuration
# Initial experimental playback provider API credentials.
# (Configured in Phase 7)
NEXSTREAM_BASE_URL=
NEXSTREAM_API_KEY=

# FrameXTV Playback Provider (Experimental / Controlled Local Testing & Approved Production Demo)
# Disabled by default in all environments.
# - Local development testing: Set ENABLE_FRAMEXTV_PROVIDER=true in .env.local
# - Production deployment: Requires BOTH ENABLE_FRAMEXTV_PROVIDER=true AND FRAMEXTV_PRODUCTION_APPROVED=true in production environment variables (e.g. Vercel Project Settings)
ENABLE_FRAMEXTV_PROVIDER=false
FRAMEXTV_PRODUCTION_APPROVED=false
FRAMEXTV_BASE_URL=https://framextv.xyz

# Supabase Configuration
# Future persistence for profiles, watchlists, and history.
# (Configured in Phase 8)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
